<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Detalle de producto del Comprador (C3).
  Origen completo del café, stepper de cantidades y agregar al carrito.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_24"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingBottom="@dimen/spacing_24">

        <ImageView
            android:id="@+id/product_detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/spacing_16"
            android:contentDescription="@string/recovery_back_cd"
            android:padding="@dimen/spacing_8"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/cafe_700" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CafeOrigen.Card"
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <ImageView
                android:id="@+id/product_detail_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/vendor_product_image_cd"
                android:scaleType="centerInside"
                android:padding="@dimen/spacing_24"
                android:src="@drawable/ic_storefront"
                app:tint="@color/cafe_300" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/product_detail_name_text"
                style="@style/TextAppearance.CafeOrigen.Display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/product_detail_category_badge"
                style="@style/TextAppearance.CafeOrigen.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_info"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/info" />
        </LinearLayout>

        <TextView
            android:id="@+id/product_detail_vendor_text"
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4" />

        <TextView
            android:id="@+id/product_detail_price_text"
            style="@style/TextAppearance.CafeOrigen.Price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12" />

        <TextView
            android:id="@+id/product_detail_stock_text"
            style="@style/TextAppearance.CafeOrigen.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8" />

        <LinearLayout
            android:id="@+id/product_detail_meta_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:orientation="horizontal">

            <com.cafeorigen.core.ui.RowItemView
                android:id="@+id/product_detail_region_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:layout_weight="1"
                app:rowIcon="@drawable/ic_location"
                app:rowShowChevron="false" />

            <com.cafeorigen.core.ui.RowItemView
                android:id="@+id/product_detail_variety_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:rowIcon="@drawable/ic_agriculture"
                app:rowShowChevron="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/product_detail_description_text"
            style="@style/TextAppearance.CafeOrigen.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16" />

        <!-- Selector de cantidad -->
        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/buyer_qty_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/product_detail_minus_button"
                style="@style/Widget.CafeOrigen.Button.Secondary"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/buyer_qty_minus_cd"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:icon="@drawable/ic_remove"
                app:iconTint="@color/cafe_700" />

            <TextView
                android:id="@+id/product_detail_qty_text"
                style="@style/TextAppearance.CafeOrigen.Title"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/product_detail_plus_button"
                style="@style/Widget.CafeOrigen.Button.Secondary"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/buyer_qty_plus_cd"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/cafe_700" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/product_detail_line_total_text"
                style="@style/TextAppearance.CafeOrigen.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/product_detail_add_button"
            style="@style/Widget.CafeOrigen.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/action_add_to_cart"
            app:icon="@drawable/ic_shopping_cart" />

    </LinearLayout>

</ScrollView>
