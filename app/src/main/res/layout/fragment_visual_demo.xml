<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Demostración del sistema visual (roles en construcción).
  Se mantiene como referencia de identidad mientras se implementan las
  pantallas de Comprador y Vendedor.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/demo_section_kpis" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="horizontal">

            <com.cafeorigen.core.ui.KpiCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:layout_weight="1"
                app:kpiAccentColor="@color/accent_gold"
                app:kpiIcon="@drawable/ic_bar_chart"
                app:kpiLabel="@string/demo_kpi_sales_label"
                app:kpiValue="@string/demo_kpi_sales_value" />

            <com.cafeorigen.core.ui.KpiCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:layout_weight="1"
                app:kpiAccentColor="@color/cafe_600"
                app:kpiIcon="@drawable/ic_group"
                app:kpiLabel="@string/demo_kpi_users_label"
                app:kpiValue="@string/demo_kpi_users_value" />

            <com.cafeorigen.core.ui.KpiCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:kpiAccentColor="@color/success"
                app:kpiIcon="@drawable/ic_inventory"
                app:kpiLabel="@string/demo_kpi_orders_label"
                app:kpiValue="@string/demo_kpi_orders_value" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/demo_section_products" />

        <include
            layout="@layout/item_product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12" />

        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/demo_section_chart" />

        <com.cafeorigen.core.ui.BarChartView
            android:id="@+id/demo_chart_view"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="@dimen/spacing_12"
            app:barColor="@color/accent_gold"
            app:barTrackColor="@color/cafe_100" />

        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/demo_chart_meta" />

        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/demo_section_buttons" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.CafeOrigen.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/action_save" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.CafeOrigen.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/action_buy_now" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.CafeOrigen.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:layout_weight="1"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.CafeOrigen.Button.Destructive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_delete" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/demo_section_states" />

        <com.cafeorigen.core.ui.RowItemView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            app:rowIcon="@drawable/ic_location"
            app:rowShowChevron="true"
            app:rowSubtitle="@string/demo_row_subtitle"
            app:rowTitle="@string/demo_row_title" />

        <com.cafeorigen.core.ui.EmptyStateView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_16" />
    </LinearLayout>

</ScrollView>
