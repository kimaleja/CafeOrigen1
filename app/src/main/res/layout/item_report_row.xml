<?xml version="1.0" encoding="utf-8"?>
<!-- CafeOrigen — Fila del ranking de productos en el reporte de ventas (A7) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/spacing_12"
    android:paddingBottom="@dimen/spacing_12">

    <TextView
        android:id="@+id/report_rank_text"
        style="@style/TextAppearance.CafeOrigen.Price"
        android:layout_width="56dp"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/report_product_name_text"
            style="@style/TextAppearance.CafeOrigen.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/report_product_units_text"
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/report_product_revenue_text"
        style="@style/TextAppearance.CafeOrigen.Price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
