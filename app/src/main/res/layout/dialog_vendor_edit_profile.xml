<?xml version="1.0" encoding="utf-8"?>
<!-- CafeOrigen — Diálogo de edición de perfil del Vendedor (V8) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_24"
    android:paddingEnd="@dimen/spacing_24"
    android:paddingTop="@dimen/spacing_16">

    <TextView
        style="@style/TextAppearance.CafeOrigen.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vendor_profile_edit_title" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/vendor_edit_name_input"
        style="@style/Widget.CafeOrigen.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:hint="@string/hint_name"
        app:startIconDrawable="@drawable/ic_person">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/vendor_edit_name_edit"
            style="@style/Widget.CafeOrigen.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_field_height"
            android:inputType="textPersonName|textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/vendor_edit_phone_input"
        style="@style/Widget.CafeOrigen.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginBottom="@dimen/spacing_16"
        android:hint="@string/hint_phone"
        app:startIconDrawable="@drawable/ic_smartphone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/vendor_edit_phone_edit"
            style="@style/Widget.CafeOrigen.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_field_height"
            android:inputType="phone" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
