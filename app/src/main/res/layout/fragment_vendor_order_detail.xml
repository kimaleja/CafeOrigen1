<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Detalle de pedido del Vendedor (V7).
  Comprador, dirección, líneas del pedido, total y acciones según estado.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_24"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_24">

        <ImageView
            android:id="@+id/order_detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/recovery_back_cd"
            android:padding="@dimen/spacing_8"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/cafe_700" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/order_detail_buyer_text"
                style="@style/TextAppearance.CafeOrigen.Display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/order_detail_status_badge"
                style="@style/TextAppearance.CafeOrigen.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_warning"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/order_detail_placed_text"
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4" />

        <com.cafeorigen.core.ui.RowItemView
            android:id="@+id/order_detail_address_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            app:rowIcon="@drawable/ic_location"
            app:rowTitle="@string/vendor_order_address_label" />

        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/vendor_order_items_label" />

        <LinearLayout
            android:id="@+id/order_detail_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.CafeOrigen.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vendor_order_total_label" />

            <TextView
                android:id="@+id/order_detail_total_text"
                style="@style/TextAppearance.CafeOrigen.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/order_detail_secondary_button"
                style="@style/Widget.CafeOrigen.Button.Destructive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:layout_weight="1"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/order_detail_primary_button"
                style="@style/Widget.CafeOrigen.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/order_detail_note_text"
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:gravity="center"
            android:text="@string/vendor_no_actions"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
