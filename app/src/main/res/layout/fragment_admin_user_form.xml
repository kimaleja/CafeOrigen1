<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Formulario de usuario compartido por Crear (A3) y Editar (A4).
  Validaciones en ViewModel; el switch de estado solo aplica en edición.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_24"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_24">

        <ImageView
            android:id="@+id/user_form_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/recovery_back_cd"
            android:padding="@dimen/spacing_8"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/cafe_700" />

        <TextView
            android:id="@+id/user_form_title_text"
            style="@style/TextAppearance.CafeOrigen.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/form_title_create" />

        <TextView
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/form_subtitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/user_form_name_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:hint="@string/hint_name"
            app:startIconDrawable="@drawable/ic_person">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/user_form_name_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/user_form_email_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/login_hint_email"
            app:startIconDrawable="@drawable/ic_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/user_form_email_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/user_form_phone_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/hint_phone"
            app:startIconDrawable="@drawable/ic_smartphone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/user_form_phone_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/user_form_password_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/login_hint_password"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lock">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/user_form_password_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/user_form_role_input"
            style="@style/Widget.CafeOrigen.TextInputLayout.ExposedDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/form_hint_role"
            app:startIconDrawable="@drawable/ic_group">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/user_form_role_input_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textAppearance="@style/TextAppearance.CafeOrigen.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/user_form_active_switch"
            style="@style/TextAppearance.CafeOrigen.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:checked="true"
            android:text="@string/form_switch_active"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/user_form_cancel_button"
                style="@style/Widget.CafeOrigen.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:layout_weight="1"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/user_form_save_button"
                style="@style/Widget.CafeOrigen.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_save" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
