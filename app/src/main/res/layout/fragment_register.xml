<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_24"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_24">

        <ImageView
            android:id="@+id/register_back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/recovery_back_cd"
            android:padding="@dimen/spacing_8"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/cafe_700" />

        <ImageView
            android:layout_width="@dimen/size_avatar"
            android:layout_height="@dimen/size_avatar"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_cafeorigen" />

        <TextView
            style="@style/TextAppearance.CafeOrigen.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/register_title" />

        <TextView
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_4"
            android:gravity="center"
            android:text="@string/register_subtitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_name_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:hint="@string/hint_name"
            app:startIconDrawable="@drawable/ic_person">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_name_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_email_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/login_hint_email"
            app:startIconDrawable="@drawable/ic_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_email_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_phone_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/hint_phone"
            app:startIconDrawable="@drawable/ic_smartphone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_phone_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_password_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/login_hint_password"
            app:startIconDrawable="@drawable/ic_lock"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_password_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_confirm_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/hint_password_confirm"
            app:startIconDrawable="@drawable/ic_lock"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_confirm_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/register_terms_checkbox"
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/register_terms" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/register_action_button"
            style="@style/Widget.CafeOrigen.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/register_action" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.CafeOrigen.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_have_account" />

            <TextView
                android:id="@+id/register_login_text"
                style="@style/TextAppearance.CafeOrigen.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:padding="@dimen/spacing_4"
                android:text="@string/register_login_link" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
