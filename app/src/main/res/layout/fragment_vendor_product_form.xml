<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Formulario de producto del Vendedor (V3 crear / V4 editar).
  Imagen desde galería (GetContent), categoría, precio/stock/descripción y
  estados: guardar borrador o enviar a moderación.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_24"
        android:paddingEnd="@dimen/spacing_24"
        android:paddingTop="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_24">

        <ImageView
            android:id="@+id/product_form_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/recovery_back_cd"
            android:padding="@dimen/spacing_8"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/cafe_700" />

        <TextView
            android:id="@+id/product_form_title_text"
            style="@style/TextAppearance.CafeOrigen.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vendor_new_product_title" />

        <TextView
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/vendor_product_form_subtitle" />

        <!-- Imagen del café -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/product_image_card"
            style="@style/Widget.CafeOrigen.Card"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="@dimen/spacing_16">

            <ImageView
                android:id="@+id/product_form_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/vendor_product_image_cd"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_storefront"
                app:tint="@color/cafe_300" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/spacing_12"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/product_form_gallery_button"
                    style="@style/Widget.CafeOrigen.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/spacing_24"
                    android:paddingEnd="@dimen/spacing_24"
                    android:text="@string/vendor_pick_gallery"
                    app:icon="@drawable/ic_photo_library"
                    app:iconTint="@color/cafe_700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/product_form_camera_button"
                    style="@style/Widget.CafeOrigen.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_12"
                    android:enabled="false"
                    android:alpha="0.6"
                    android:paddingStart="@dimen/spacing_24"
                    android:paddingEnd="@dimen/spacing_24"
                    android:text="@string/vendor_take_photo"
                    app:icon="@drawable/ic_camera"
                    app:iconTint="@color/cafe_700" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/product_form_name_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:hint="@string/vendor_hint_name"
            app:startIconDrawable="@drawable/ic_storefront">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/product_form_name_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="text|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/product_form_category_input"
            style="@style/Widget.CafeOrigen.TextInputLayout.ExposedDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/vendor_hint_category"
            app:startIconDrawable="@drawable/ic_grid_view">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/product_form_category_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textAppearance="@style/TextAppearance.CafeOrigen.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/product_form_price_input"
                style="@style/Widget.CafeOrigen.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:layout_weight="1"
                android:hint="@string/vendor_hint_price"
                app:startIconDrawable="@drawable/ic_credit_card">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/product_form_price_edit"
                    style="@style/Widget.CafeOrigen.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_field_height"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/product_form_stock_input"
                style="@style/Widget.CafeOrigen.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/vendor_hint_stock"
                app:startIconDrawable="@drawable/ic_inventory">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/product_form_stock_edit"
                    style="@style/Widget.CafeOrigen.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_field_height"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/product_form_description_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/vendor_hint_description"
            app:counterEnabled="true"
            app:counterMaxLength="280"
            app:startIconDrawable="@drawable/ic_agriculture">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/product_form_description_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:lines="3"
                android:maxLength="280"
                android:textAppearance="@style/TextAppearance.CafeOrigen.Body" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/product_form_region_input"
            style="@style/Widget.CafeOrigen.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/vendor_hint_region"
            app:startIconDrawable="@drawable/ic_location">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/product_form_region_edit"
                style="@style/Widget.CafeOrigen.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_field_height"
                android:inputType="text|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/product_form_variety_input"
                style="@style/Widget.CafeOrigen.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:layout_weight="1"
                android:hint="@string/vendor_hint_variety"
                app:startIconDrawable="@drawable/ic_agriculture">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/product_form_variety_edit"
                    style="@style/Widget.CafeOrigen.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_field_height"
                    android:inputType="text|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/product_form_altitude_input"
                style="@style/Widget.CafeOrigen.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/vendor_hint_altitude"
                app:startIconDrawable="@drawable/ic_my_location">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/product_form_altitude_edit"
                    style="@style/Widget.CafeOrigen.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_field_height"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/vendor_altitude_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/product_form_draft_button"
                style="@style/Widget.CafeOrigen.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                android:layout_weight="1"
                android:text="@string/vendor_save_draft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/product_form_submit_button"
                style="@style/Widget.CafeOrigen.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vendor_send_moderation" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
