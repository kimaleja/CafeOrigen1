<?xml version="1.0" encoding="utf-8"?>
<!-- CafeOrigen — Ítem de producto en la moderación del Administrador (A6) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CafeOrigen.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="@dimen/spacing_12"
    android:padding="@dimen/spacing_14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_icon_badge">

            <ImageView
                android:layout_width="@dimen/size_icon"
                android:layout_height="@dimen/size_icon"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_storefront"
                app:tint="@color/cafe_700" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/product_name_text"
                style="@style/TextAppearance.CafeOrigen.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/product_vendor_text"
                style="@style/TextAppearance.CafeOrigen.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/product_status_badge"
            style="@style/TextAppearance.CafeOrigen.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_info"
            android:paddingStart="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_8"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/product_meta_text"
        style="@style/TextAppearance.CafeOrigen.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/product_price_text"
            style="@style/TextAppearance.CafeOrigen.Price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/product_approve_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_approve"
            android:padding="@dimen/spacing_6"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/success" />

        <ImageView
            android:id="@+id/product_reject_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/spacing_4"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_reject"
            android:padding="@dimen/spacing_6"
            android:src="@drawable/ic_close"
            app:tint="@color/warning" />

        <ImageView
            android:id="@+id/product_delete_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/spacing_4"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_delete"
            android:padding="@dimen/spacing_6"
            android:src="@drawable/ic_delete"
            app:tint="@color/danger" />
    </LinearLayout>

</LinearLayout>
