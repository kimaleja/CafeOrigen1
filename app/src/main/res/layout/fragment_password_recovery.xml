<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Recuperación de contraseña (T3). Dos pasos en un solo layout:
  paso 1 correo (envía código) y paso 2 código + contraseña nueva.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/recovery_back_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_16"
        android:contentDescription="@string/recovery_back_cd"
        android:padding="@dimen/spacing_8"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/cafe_700" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_24"
            android:paddingEnd="@dimen/spacing_24"
            android:paddingBottom="@dimen/spacing_24">

            <TextView
                style="@style/TextAppearance.CafeOrigen.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/recovery_title" />

            <TextView
                android:id="@+id/recovery_subtitle_text"
                style="@style/TextAppearance.CafeOrigen.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/recovery_subtitle" />

            <!-- PASO 1: correo -->
            <LinearLayout
                android:id="@+id/recovery_step1_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/recovery_email_input"
                    style="@style/Widget.CafeOrigen.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:hint="@string/login_hint_email"
                    app:startIconDrawable="@drawable/ic_mail">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recovery_email_edit"
                        style="@style/Widget.CafeOrigen.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_field_height"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recovery_send_code_button"
                    style="@style/Widget.CafeOrigen.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_20"
                    android:text="@string/recovery_action_send_code" />
            </LinearLayout>

            <!-- PASO 2: código + nueva contraseña -->
            <LinearLayout
                android:id="@+id/recovery_step2_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.CafeOrigen.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="@string/recovery_step2_subtitle" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/recovery_code_input"
                    style="@style/Widget.CafeOrigen.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:hint="@string/recovery_hint_code"
                    app:startIconDrawable="@drawable/ic_assignment">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recovery_code_edit"
                        style="@style/Widget.CafeOrigen.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_field_height"
                        android:inputType="number"
                        android:maxLength="6" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/recovery_password_input"
                    style="@style/Widget.CafeOrigen.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:hint="@string/recovery_hint_new_password"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recovery_password_edit"
                        style="@style/Widget.CafeOrigen.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_field_height"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/recovery_confirm_input"
                    style="@style/Widget.CafeOrigen.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:hint="@string/hint_password_confirm"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recovery_confirm_edit"
                        style="@style/Widget.CafeOrigen.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_field_height"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recovery_reset_button"
                    style="@style/Widget.CafeOrigen.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_20"
                    android:text="@string/recovery_action_reset" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
