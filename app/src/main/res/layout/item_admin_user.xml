<?xml version="1.0" encoding="utf-8"?>
<!-- CafeOrigen — Ítem de usuario en el listado del Administrador (A2) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CafeOrigen.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="@dimen/spacing_12"
    android:padding="@dimen/spacing_14">

    <TextView
        android:id="@+id/user_initials_text"
        style="@style/TextAppearance.CafeOrigen.Title"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/shape_avatar"
        android:gravity="center"
        android:text="CR" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/user_name_text"
            style="@style/TextAppearance.CafeOrigen.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/user_email_text"
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/user_role_badge"
                style="@style/TextAppearance.CafeOrigen.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_info"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/info"
                android:text="@string/chip_admin" />

            <TextView
                android:id="@+id/user_active_badge"
                style="@style/TextAppearance.CafeOrigen.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:background="@drawable/bg_tag_success"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/success"
                android:text="@string/users_state_active" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/user_overflow_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_edit"
        android:padding="@dimen/spacing_4"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/cafe_600" />

</LinearLayout>
