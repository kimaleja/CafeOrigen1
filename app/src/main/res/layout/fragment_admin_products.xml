<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Moderación de productos (A6). Filtro por estado, acciones de
  aprobar / rechazar / eliminar y estado vacío.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/products_filter_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_16"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_products_all"
            style="@style/Widget.CafeOrigen.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="true"
            android:text="@string/products_filter_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_products_pending"
            style="@style/Widget.CafeOrigen.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/products_filter_pending" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_products_active"
            style="@style/Widget.CafeOrigen.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/products_filter_active" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_products_rejected"
            style="@style/Widget.CafeOrigen.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/products_filter_rejected" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_products_draft"
            style="@style/Widget.CafeOrigen.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/products_filter_draft" />
    </com.google.android.material.chip.ChipGroup>

    <ProgressBar
        android:id="@+id/products_progress"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/spacing_32"
        android:indeterminateTint="@color/accent_gold"
        android:visibility="gone" />

    <com.cafeorigen.core.ui.EmptyStateView
        android:id="@+id/products_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/products_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_12"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_32" />

</LinearLayout>
