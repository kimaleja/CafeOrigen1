<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Catálogo del Comprador (C2).
  Búsqueda por nombre/región, chips por categoría y lista de productos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/buyer_catalog_search_input"
        style="@style/Widget.CafeOrigen.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_16"
        android:hint="@string/action_search_hint"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/buyer_catalog_search_edit"
            style="@style/Widget.CafeOrigen.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_field_height"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/buyer_catalog_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_12"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_catalog_all"
            style="@style/Widget.CafeOrigen.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="true"
            android:text="@string/chip_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_catalog_grano"
            style="@style/Widget.CafeOrigen.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/category_cafe_grano" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_catalog_molido"
            style="@style/Widget.CafeOrigen.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/category_cafe_molido" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_catalog_verde"
            style="@style/Widget.CafeOrigen.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/category_cafe_verde" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_catalog_accesorios"
            style="@style/Widget.CafeOrigen.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/category_accesorios" />
    </com.google.android.material.chip.ChipGroup>

    <ProgressBar
        android:id="@+id/buyer_catalog_progress"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/spacing_32"
        android:indeterminateTint="@color/accent_gold"
        android:visibility="gone" />

    <com.cafeorigen.core.ui.EmptyStateView
        android:id="@+id/buyer_catalog_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/buyer_catalog_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_12"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_32" />

</LinearLayout>
