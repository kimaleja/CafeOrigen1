<?xml version="1.0" encoding="utf-8"?>
<!-- CafeOrigen — Tarjeta de producto del catálogo/inicio del Comprador -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CafeOrigen.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginBottom="@dimen/spacing_12"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_14">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/shape_icon_badge">

        <ImageView
            android:id="@+id/product_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/vendor_product_image_cd"
            android:padding="@dimen/spacing_10"
            android:src="@drawable/ic_storefront"
            app:tint="@color/cafe_700" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/product_name_text"
            style="@style/TextAppearance.CafeOrigen.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/product_vendor_text"
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/product_category_text"
                style="@style/TextAppearance.CafeOrigen.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_info"
                android:textColor="@color/info"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/product_stock_text"
                style="@style/TextAppearance.CafeOrigen.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:gravity="center_vertical" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/product_price_text"
        style="@style/TextAppearance.CafeOrigen.Price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
