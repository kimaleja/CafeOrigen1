<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Tarjeta de producto reutilizable.
  Sirve para catálogo, home y listas de vendedor/admin (los adaptadores
  reutilizan este layout en la fase de pantallas).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CafeOrigen.Card.Product"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_thumb_lg">

            <ImageView
                android:id="@+id/product_thumb_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:padding="@dimen/spacing_20"
                android:src="@drawable/ic_logo_cafeorigen"
                android:background="@drawable/shape_product_thumb" />

            <TextView
                android:id="@+id/product_stock_tag"
                style="@style/TextAppearance.CafeOrigen.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/spacing_8"
                android:background="@drawable/bg_tag_success"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/demo_product_stock"
                android:textColor="@color/success"
                android:contentDescription="@string/demo_product_stock_cd" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_12">

            <TextView
                android:id="@+id/product_name_text"
                style="@style/TextAppearance.CafeOrigen.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/demo_product_name" />

            <TextView
                android:id="@+id/product_meta_text"
                style="@style/TextAppearance.CafeOrigen.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/demo_product_meta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/product_price_text"
                    style="@style/TextAppearance.CafeOrigen.Price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/demo_product_price" />

                <ImageView
                    android:id="@+id/product_add_image"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/shape_icon_badge"
                    android:contentDescription="@string/action_add_to_cart"
                    android:padding="5dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/cafe_700" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
