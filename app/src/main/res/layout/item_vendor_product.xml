<?xml version="1.0" encoding="utf-8"?>
<!-- CafeOrigen — Ítem de producto en el listado del Vendedor (V2) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CafeOrigen.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_14">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/shape_icon_badge">

        <ImageView
            android:id="@+id/product_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/vendor_product_image_cd"
            android:src="@drawable/ic_storefront"
            app:tint="@color/cafe_700" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/product_name_text"
            style="@style/TextAppearance.CafeOrigen.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/product_category_text"
                style="@style/TextAppearance.CafeOrigen.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/product_status_badge"
                style="@style/TextAppearance.CafeOrigen.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/product_stock_text"
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/product_price_text"
            style="@style/TextAppearance.CafeOrigen.Price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/product_overflow_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/spacing_8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_edit"
            android:padding="@dimen/spacing_4"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/cafe_600" />
    </LinearLayout>

</LinearLayout>
