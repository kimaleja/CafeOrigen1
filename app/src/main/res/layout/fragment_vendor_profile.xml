<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Perfil del Vendedor (V8).
  Avatar, datos de contacto, finca, certificaciones, edición y logout.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24">

        <TextView
            android:id="@+id/vendor_profile_avatar"
            style="@style/TextAppearance.CafeOrigen.Display"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/shape_avatar"
            android:gravity="center"
            android:text="DT" />

        <TextView
            android:id="@+id/vendor_profile_name_text"
            style="@style/TextAppearance.CafeOrigen.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:gravity="center" />

        <TextView
            android:id="@+id/vendor_profile_email_text"
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4" />

        <TextView
            android:id="@+id/vendor_profile_farm_text"
            style="@style/TextAppearance.CafeOrigen.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:drawableStart="@drawable/ic_agriculture"
            android:drawablePadding="@dimen/spacing_8"
            android:drawableTint="@color/cafe_500" />

        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/vendor_cert_label" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12">

            <com.google.android.material.chip.Chip
                style="@style/Widget.CafeOrigen.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/vendor_cert_organic" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.CafeOrigen.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/vendor_cert_forest" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.CafeOrigen.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/vendor_cert_fair" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            style="@style/TextAppearance.CafeOrigen.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/vendor_profile_help_short" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vendor_profile_edit_button"
            style="@style/Widget.CafeOrigen.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="@string/vendor_profile_edit_action" />

        <com.cafeorigen.core.ui.RowItemView
            android:id="@+id/vendor_profile_logout_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            app:rowIcon="@drawable/ic_logout"
            app:rowShowChevron="false"
            app:rowSubtitle=""
            app:rowTitle="@string/action_logout" />

    </LinearLayout>

</ScrollView>
