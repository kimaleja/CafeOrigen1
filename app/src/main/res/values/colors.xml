<?xml version="1.0" encoding="utf-8"?>
<!--
  CafeOrigen — Paleta de color personalizada (etapa: sistema visual)
  Basada en el documento de planeación (Actividad 2) y los mockups aprobados.
  Refleja la identidad: café colombiano, cremas, dorado y verde de éxito.
-->
<resources>

    <!-- Marca: tonos de café -->
    <color name="cafe_900">#3E2723</color>
    <color name="cafe_800">#4E342E</color>
    <color name="cafe_700">#5D4037</color>
    <color name="cafe_600">#6D4C41</color>
    <color name="cafe_500">#8D6E63</color>
    <color name="cafe_400">#A1887F</color>
    <color name="cafe_300">#D7CCC8</color>
    <color name="cafe_200">#E6DED9</color>
    <color name="cafe_100">#EFEBE9</color>

    <!-- Fondos -->
    <color name="crema_background">#FAF7F2</color>
    <color name="surface">#FFFFFF</color>

    <!-- Acento dorado (destacados / Club de Café) -->
    <color name="accent_gold">#C8A15A</color>
    <color name="accent_gold_dark">#A8834A</color>
    <color name="gold_container">#F2E7D2</color>

    <!-- Semáforo de estados -->
    <color name="success">#2E7D32</color>
    <color name="success_container">#C8E6C9</color>
    <color name="warning">#E65100</color>
    <color name="warning_container">#FFE0B2</color>
    <color name="danger">#B71C1C</color>
    <color name="danger_container">#FFCDD2</color>
    <color name="info">#0D47A1</color>
    <color name="info_container">#BBDEFB</color>

    <!-- Texto -->
    <color name="text_primary">#212121</color>
    <color name="text_secondary">#6B6B6B</color>
    <color name="text_hint">#9E9E9E</color>
    <color name="text_on_dark">#FFFFFF</color>
    <color name="text_on_dark_soft">#EFEBE9</color>

    <!-- Bordes / separadores -->
    <color name="outline">#E0D6CE</color>
    <color name="divider">#EDE3DC</color>

    <!-- Alias para el tema Material -->
    <color name="color_primary">@color/cafe_700</color>
    <color name="color_on_primary">@color/text_on_dark</color>
    <color name="color_surface">@color/surface</color>
    <color name="color_background">@color/crema_background</color>
    <color name="color_on_surface">@color/text_primary</color>
    <color name="color_on_surface_variant">@color/text_secondary</color>
    <color name="color_outline">@color/outline</color>
    <color name="color_error">@color/danger</color>

</resources>
